---
export const prerender = true;
import AllProjects from "../react/AllProjects";
import type { ProjectData } from "../react/MyProjects";
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/all-projects.css";
import db from "../db/client";

const projects = (
  db.prepare("SELECT * FROM projects ORDER BY id DESC").all() as any[]
).map((p) => ({
  ...p,
  tags: JSON.parse(p.tags),
  images: JSON.parse(p.images),
})) as ProjectData[];
---

<BaseLayout
  title="Proyectos | Antoni Acevedo, Desarrollador Web y Móvil"
  description="Portafolio de proyectos web, back-end y aplicaciones móviles desarrollados por Antoni Acevedo con React, Vue, Node.js, NestJS y React Native."
>
    <main class="ap-page">
      <AllProjects client:load projects={projects} />
    </main>
</BaseLayout>
