---
import BaseLayout from "../layouts/BaseLayout.astro";

export const prerender = true;
---

<BaseLayout
  title="Página no encontrada | Antoni Acevedo"
  description="La página que buscas no existe. Vuelve al portafolio de Antoni Acevedo, desarrollador web full-stack."
  noindex
>
  <main
    class="min-h-screen flex flex-col items-center justify-center gap-4 bg-[#f3f3f3] text-[#1A1A1A] font-sans text-center px-6"
  >
    <h1 class="text-7xl font-light tracking-tight">404</h1>
    <p class="text-gray-600">Esta página no existe.</p>
    <a
      href={import.meta.env.BASE_URL}
      class="border-b border-black pb-1 hover:opacity-70 transition-opacity"
    >
      Volver al portafolio
    </a>
  </main>
</BaseLayout>
