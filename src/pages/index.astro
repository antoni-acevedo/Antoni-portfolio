---
import Hero from "../react/index";
import About from "../react/About";
import ProyectCarrousel from "../react/ProyectCarrousel";
import MyProjects from "../react/MyProjects";
import Services from "../react/Services";
import LatestJob from "../react/LatestJob";
import Footer from "../react/Footer";
import "../styles/global.css";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Portafolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main
      class="flex flex-col items-center w-full relative font-sans text-[#1A1A1A] selection:bg-blue-100 bg-[#f3f3f3]"
    >
      <Hero client:load />
      <About client:load />
      <ProyectCarrousel client:load />
      <MyProjects client:load />
      <Services client:load />
      <LatestJob client:load />
      <Footer client:load />
    </main>
  </body>
</html>
