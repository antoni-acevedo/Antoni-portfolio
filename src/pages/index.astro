---
import Layout from "../layouts/Layout.astro";

// Placeholder data for skills
const skills = [
  { name: "Astro", icon: "🚀" },
  { name: "React", icon: "⚛️" },
  { name: "Tailwind CSS", icon: "🎨" },
  { name: "TypeScript", icon: "📘" },
  { name: "Node.js", icon: "🟩" },
  { name: "Next.js", icon: "▲" },
];

const projects = [
  {
    title: "E-Commerce Dashboard",
    description:
      "A comprehensive dashboard for managing products, orders, and analytics with real-time updates.",
    tags: ["React", "Tailwind", "Supabase"],
    color: "from-blue-500 to-cyan-500",
  },
  {
    title: "AI Image Generator",
    description:
      "Create stunning visuals using the latest diffusion models with a simple, intuitive interface.",
    tags: ["Astro", "Python", "FastAPI"],
    color: "from-purple-500 to-pink-500",
  },
  {
    title: "Portfolio V1",
    description:
      "My first personal website built to showcase my early web development journey and experiments.",
    tags: ["HTML/CSS", "JavaScript"],
    color: "from-orange-500 to-yellow-500",
  },
];
---

<Layout title="Antoni | Creative Developer">
  <main class="flex flex-col items-center w-full relative">
    <!-- Hero Section -->
    <section
      class="min-h-screen flex flex-col justify-center items-center text-center px-4 py-20 w-full max-w-6xl mx-auto relative z-10"
    >
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-purple-600/20 rounded-full blur-[100px] -z-10 animate-pulse"
      >
      </div>

      <div class="space-y-6 animate-fade-in-up">
        <span
          class="inline-block py-1 px-3 rounded-full bg-white/10 border border-white/20 text-sm backdrop-blur-md text-purple-300 font-medium"
        >
          Available for hire
        </span>
        <h1
          class="text-6xl md:text-8xl font-bold tracking-tight text-white leading-tight"
        >
          Building <span
            class="bg-gradient-to-r from-purple-400 via-pink-400 to-orange-400 bg-clip-text text-transparent"
            >Digital</span
          ><br />
          Experiences
        </h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto leading-relaxed">
          I'm a creative developer passionate about building accessible,
          pixel-perfect, and performant web experiences.
        </p>

        <div class="flex flex-wrap gap-4 justify-center pt-8">
          <a
            href="#projects"
            class="px-8 py-4 rounded-full bg-white text-gray-950 font-semibold hover:bg-gray-100 transition-all hover:scale-105 active:scale-95 shadow-[0_0_20px_rgba(255,255,255,0.3)]"
          >
            View Work
          </a>
          <a
            href="#contact"
            class="px-8 py-4 rounded-full bg-white/5 border border-white/10 text-white font-semibold hover:bg-white/10 transition-all hover:scale-105 active:scale-95 backdrop-blur-sm"
          >
            Contact Me
          </a>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="w-full max-w-6xl mx-auto px-4 py-20">
      <h2 class="text-4xl font-bold text-center mb-16 text-white">
        Tech Stack
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          skills.map((skill) => (
            <div class="flex flex-col items-center justify-center p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-purple-500/50 hover:bg-white/10 transition-all duration-300 group cursor-default">
              <span class="text-4xl mb-3 group-hover:scale-110 transition-transform duration-300">
                {skill.icon}
              </span>
              <span class="font-medium text-gray-300">{skill.name}</span>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="w-full max-w-6xl mx-auto px-4 py-20">
      <h2 class="text-4xl font-bold text-center mb-16 text-white">
        Selected Projects
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {
          projects.map((project, index) => (
            <div class="group relative rounded-3xl overflow-hidden bg-gray-900/50 border border-white/10 hover:border-white/20 transition-all duration-300 hover:shadow-2xl hover:shadow-purple-500/10">
              <div
                class={`absolute inset-0 bg-gradient-to-br ${project.color} opacity-0 group-hover:opacity-10 transition-opacity duration-500`}
              />
              <div class="p-8 h-full flex flex-col">
                <div class="mb-4">
                  <h3 class="text-2xl font-bold text-white mb-2">
                    {project.title}
                  </h3>
                  <p class="text-gray-400 line-clamp-3">
                    {project.description}
                  </p>
                </div>
                <div class="mt-auto flex flex-wrap gap-2 pt-6">
                  {project.tags.map((tag) => (
                    <span class="text-xs font-semibold px-3 py-1 rounded-full bg-white/10 text-gray-300 border border-white/5">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Call to Action -->
    <section
      id="contact"
      class="w-full max-w-4xl mx-auto px-4 py-32 text-center"
    >
      <div
        class="rounded-3xl bg-gradient-to-br from-purple-900/40 to-blue-900/40 border border-white/10 p-12 md:p-20 relative overflow-hidden backdrop-blur-sm"
      >
        <div
          class="absolute -top-24 -right-24 w-64 h-64 bg-blue-500/30 rounded-full blur-[80px]"
        >
        </div>
        <div
          class="absolute -bottom-24 -left-24 w-64 h-64 bg-purple-500/30 rounded-full blur-[80px]"
        >
        </div>

        <h2
          class="text-4xl md:text-5xl font-bold text-white mb-6 relative z-10"
        >
          Ready to start a project?
        </h2>
        <p class="text-xl text-gray-300 mb-10 max-w-xl mx-auto relative z-10">
          Let's collaborate and bring your vision to life with modern technology
          and stunning design.
        </p>
        <button
          class="relative z-10 px-8 py-4 rounded-full bg-white text-gray-900 font-bold hover:scale-105 transition-transform duration-300 shadow-xl"
        >
          Get in Touch
        </button>
      </div>
    </section>

    <footer class="w-full py-8 border-t border-white/5">
      <div class="max-w-6xl mx-auto px-4 text-center text-gray-500 text-sm">
        &copy; {new Date().getFullYear()} Portfolio. Built with Astro & Tailwind.
      </div>
    </footer>
  </main>
</Layout>

<style>
  /* Base custom animations if not using tailwind plugin */
  @keyframes fade-in-up {
    0% {
      opacity: 0;
      transform: translateY(20px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fade-in-up 0.8s ease-out forwards;
  }
</style>
