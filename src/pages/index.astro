---
import Hero from "../react/index";
export const prerender = true;
import About, { type ProfileData } from "../react/About";
import ProyectCarrousel, {
  type FeaturedProject,
} from "../react/ProyectCarrousel";
import MyProjects, { type ProjectData } from "../react/MyProjects";
import Services, { type ServiceData } from "../react/Services";
import LatestJob, { type JobData } from "../react/LatestJob";
import Footer from "../react/Footer";
import BaseLayout from "../layouts/BaseLayout.astro";
import db from "../db/client";

// Fetch Data
const profileData = db
  .prepare("SELECT * FROM profile LIMIT 1")
  .get() as ProfileData;
const services = db.prepare("SELECT * FROM services").all() as ServiceData[];
const jobs = db.prepare("SELECT * FROM jobs").all() as JobData[];
const projectsRaw = db.prepare("SELECT * FROM projects ORDER BY id DESC").all();

// Parse JSON fields for projects
const projects = projectsRaw.map((p: any) => ({
  ...p,
  tags: JSON.parse(p.tags),
  images: JSON.parse(p.images),
})) as ProjectData[];

const featuredProjects = db
  .prepare("SELECT * FROM featured_projects")
  .all() as FeaturedProject[];
---

<BaseLayout
  title="Antoni Acevedo | Desarrollador Web Full-Stack, Front-End, Back-End y Móvil"
  description="Desarrollador web freelance con más de 4 años de experiencia. Contrata desarrollo front-end, back-end y apps móviles con React, Vue, Node.js, NestJS, React Native y Flutter."
>
    <main
      class="flex flex-col items-center w-full relative font-sans text-[#1A1A1A] selection:bg-blue-100 bg-[#f3f3f3]"
    >
      <Hero client:load />
      <MyProjects client:load projects={projects} />
            <ProyectCarrousel client:load initialProjects={featuredProjects} />

      <Services client:load services={services} />


      <LatestJob client:load jobs={jobs} />
      <About client:load profileData={profileData} />

      <Footer client:load />
    </main>
</BaseLayout>
